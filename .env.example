# Shared signing secret between controller and relay/agent
TRACED_SHARED_SECRET=change-me

# API keys
OPS_API_KEY=ops-key-change-me
EDGE_API_KEY=edge-key-change-me

# Controller syslog (optional)
TRACED_SO_HOST=
TRACED_SO_PORT=514
TRACED_SO_PROTO=udp

# Relay syslog destination (Security Onion)
EDGE_SO_HOST=127.0.0.1
EDGE_SO_PORT=514
EDGE_SO_PROTO=udp

EDGE_RELAY_ID=relay-1
EDGE_POLL_SECONDS=30

# Canary provider
CANARY_API_BASE=https://<your-canary-host>
CANARY_AUTH_TOKEN=change-me
CANARY_FLOCK_ID=flock:default

# Optional relay mapping metadata (reported to controller)
EDGE_META_HOSTNAME=
EDGE_META_MODEL=
EDGE_META_SERIAL=
EDGE_META_ARCH=

# Dashboard webhook (Base44 push integration)
DASHBOARD_WEBHOOK_URL=https://<your-dashboard-host>/api/functions/controllerSync
DASHBOARD_WEBHOOK_SECRET=
